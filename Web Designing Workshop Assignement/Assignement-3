<!DOCTYPE html>
<html lang="en">
    <head>
        <title>Block and Inline Elements</title>
        <meta charset="UTF-8">
        <style>
            .block {
                display: block;
                width: 100%;
                background-color: lightblue;
                padding: 10px;
                margin-bottom: 10px;
            }
            .inline {
                display: inline;
                background-color: lightgreen;
                padding: 5px;
                margin-right: 5px;
            }
          