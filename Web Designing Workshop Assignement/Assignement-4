<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Semantic and Non-Semantic Elements</title>
</head>
<body>
    <header>
        <h1>College Portal</h1>
    </header>
    <nav>
        <a href="#">Home</a> |
        <a href="#">Courses</a>
    </nav>
    <main id="home">
        <section>
            <h2>Admission Open</h2>
            <p>Apply before 30 November 2023.</p>
        </section>
    </main>
    <p>Notice: Library closed Sunday.</p>
    <footer>
        <p>&copy; 2026 college</p>
    </footer>
    <!-- non-semantic elements -->
    <p>div and span are non-semantic elements.</p>
</body>
</html>
   